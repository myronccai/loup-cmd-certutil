@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "certutil";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Hash files and convert them to and from base64 and hex (a Loup recreation of the Windows certutil verbs).";

# certutil's ERRORLEVEL is 0 or the failing HRESULT, a negative number
# (Linux keeps its low 8 bits: 0x80070002 arrives as 2).
pub const EXIT_OK: int = 0;
