@mode(host.dual)

# Checks made before reading or writing a file, so that every failure has
# certutil's HRESULT. (In native builds of Loup 1.26.0 a failed read or
# write cannot be caught, and some writes fail silently.)
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code.

from io.fs import (exists, isDir, isFile);
from win.paths import (parent_dir);
from commands.results import (HR_ACCESS_DENIED, HR_FILE_EXISTS, HR_FILE_NOT_FOUND,
    HR_PATH_NOT_FOUND);

# The HRESULT that reading `path` (fs form) would fail with, or None.
# (HRESULTs are commands.results.HResult values; an imported type alias
# cannot be named in a signature in Loup 1.26.0, so these say `int`.)
pub func input_problem(path: string): int? {
    if (isFile(path)) {
        return None;
    }
    if (isDir(path)) {
        return Some(HR_ACCESS_DENIED);
    }
    let dir = parent_dir(path);
    if (dir.len() > 0 and !isDir(dir)) {
        return Some(HR_PATH_NOT_FOUND);
    }
    return Some(HR_FILE_NOT_FOUND);
}

# The HRESULT that writing `path` would fail with, or None. An existing
# file is only replaced with -f.
pub func output_problem(path: string, force: bool): int? {
    if (isDir(path)) {
        return Some(HR_ACCESS_DENIED);
    }
    if (exists(path) and !force) {
        return Some(HR_FILE_EXISTS);
    }
    let dir = parent_dir(path);
    if (dir.len() > 0 and !isDir(dir)) {
        return Some(HR_PATH_NOT_FOUND);
    }
    return None;
}
