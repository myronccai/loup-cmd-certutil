@mode(host.dual)

# SHA-256 (FIPS 180-4) in pure Loup. 32-bit big-endian words, kept in
# Loup's 64-bit int and masked to 32 bits.
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: the round constants; compress, which mixes one 64-byte block into
# the state; and sha256_hex, which runs compress over every full block of the
# data and then over the one or two padded tail blocks from
# hash.common.padded_tail, so the message is never copied whole.

from hash.common import (MASK32, rotr32, load_block, padded_tail, hex_word);

# The first 32 bits of the fractional parts of the cube roots of the first
# 64 primes.
func round_constants(): list[int] {
    return [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
}

# Processes one 64-byte block (in buf) into the state h[0..8]; w is a
# 64-word scratch list and k the round constants.
func compress(buf: list[int], k: list[int], edits w: list[int], edits h: list[int]): void {
    # The message schedule: the block's 16 words, expanded to 64.
    for (i in 0..16) {
        let j = i * 4;
        w[i] = (buf[j] << 24) | (buf[j + 1] << 16) | (buf[j + 2] << 8) | buf[j + 3];
    }
    for (i in 16..64) {
        let s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        let s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & MASK32;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];
    # 64 rounds, one per round constant.
    for (i in 0..64) {
        let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        let ch = (e & f) ^ ((e ^ MASK32) & g);
        let t1 = (hh + s1 + ch + k[i] + w[i]) & MASK32;
        let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = (s0 + maj) & MASK32;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & MASK32;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & MASK32;
    }
    h[0] = (h[0] + a) & MASK32;
    h[1] = (h[1] + b) & MASK32;
    h[2] = (h[2] + c) & MASK32;
    h[3] = (h[3] + d) & MASK32;
    h[4] = (h[4] + e) & MASK32;
    h[5] = (h[5] + f) & MASK32;
    h[6] = (h[6] + g) & MASK32;
    h[7] = (h[7] + hh) & MASK32;
}

# The SHA-256 digest of the data as 64 lower-case hexadecimal digits.
pub func sha256_hex(data: bytes): string {
    var h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    let k = round_constants();
    var buf: list[int] = [];
    for (n in 0..64) {
        buf.push(0);
    }
    var w: list[int] = [];
    for (n in 0..64) {
        w.push(0);
    }
    let full = data.len() / 64;
    for (blk in 0..full) {
        load_block(data, blk * 64, 64, edits: buf);
        compress(buf, k, edits: w, edits: h);
    }
    let tail = padded_tail(data, 64, 8, false);
    var start = 0;
    while (start < tail.len()) {
        for (n in 0..64) {
            buf[n] = tail[start + n];
        }
        compress(buf, k, edits: w, edits: h);
        start += 64;
    }
    var out: list[string] = [];
    for (word in h) {
        out.push(hex_word(word, 8));
    }
    return out.join("");
}
