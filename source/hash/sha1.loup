@mode(host.dual)

# SHA-1 (FIPS 180-4) in pure Loup. 32-bit big-endian words, kept in Loup's
# 64-bit int and masked to 32 bits.
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: the Sha1 class, a hash.common.BlockHash whose compress() mixes
# one 64-byte block into the state (the base class drives the blocks and
# the padding); and sha1_hex.

from hash.common import (BlockHash, MASK32, rotl32, zeros);

pub class Sha1 : BlockHash {
    var w: list[int];   # the message schedule: 80 words

    new() {
        # 64-byte blocks, an 8-byte length, 4-byte words, big-endian.
        super([0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0], 64, 8, 4, false);
        this.w = zeros(80);
    }

    pub override func compress(): void {
        let buf = this.buf;
        # The message schedule: the block's 16 words, expanded to 80.
        for (i in 0..16) {
            let j = i * 4;
            this.w[i] = (buf[j] << 24) | (buf[j + 1] << 16) | (buf[j + 2] << 8) | buf[j + 3];
        }
        for (i in 16..80) {
            this.w[i] = rotl32(this.w[i - 3] ^ this.w[i - 8] ^ this.w[i - 14] ^ this.w[i - 16], 1);
        }
        var a = this.state[0];
        var b = this.state[1];
        var c = this.state[2];
        var d = this.state[3];
        var e = this.state[4];
        # 80 rounds in four groups of 20, each with its own f and constant.
        for (i in 0..80) {
            var f = 0;
            var k = 0;
            if (i < 20) {
                f = (b & c) | ((b ^ MASK32) & d);
                k = 0x5a827999;
            } else if (i < 40) {
                f = b ^ c ^ d;
                k = 0x6ed9eba1;
            } else if (i < 60) {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8f1bbcdc;
            } else {
                f = b ^ c ^ d;
                k = 0xca62c1d6;
            }
            let t = (rotl32(a, 5) + f + e + k + this.w[i]) & MASK32;
            e = d;
            d = c;
            c = rotl32(b, 30);
            b = a;
            a = t;
        }
        this.state[0] = (this.state[0] + a) & MASK32;
        this.state[1] = (this.state[1] + b) & MASK32;
        this.state[2] = (this.state[2] + c) & MASK32;
        this.state[3] = (this.state[3] + d) & MASK32;
        this.state[4] = (this.state[4] + e) & MASK32;
    }
}

# The SHA-1 digest of the data as 40 lower-case hexadecimal digits.
pub func sha1_hex(data: bytes): string {
    return Sha1().digest(data);
}
