@mode(host.dual)

# MD5 (RFC 1321) in pure Loup. 32-bit little-endian words, kept in Loup's
# 64-bit int and masked to 32 bits.
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: the step constants and rotations; compress, which mixes one
# 64-byte block into the state; and md5_hex, which runs compress over every
# full block of the data and then over the one or two padded tail blocks from
# hash.common.padded_tail, so the message is never copied whole.

from hash.common import (MASK32, rotl32, load_block, padded_tail, hex_word);

# The per-step additive constants: floor(abs(sin(i + 1)) * 2^32).
func step_constants(): list[int] {
    return [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ];
}

# The rotation of each step.
func step_rotations(): list[int] {
    return [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ];
}

# Processes one 64-byte block (in buf) into the state h[0..4].
func compress(buf: list[int], kk: list[int], ss: list[int], edits m: list[int], edits h: list[int]): void {
    for (i in 0..16) {
        let j = i * 4;
        m[i] = buf[j] | (buf[j + 1] << 8) | (buf[j + 2] << 16) | (buf[j + 3] << 24);
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    # Four rounds of 16 steps. Each round has its own mixing function f and
    # its own order g in which it takes the 16 message words.
    for (i in 0..64) {
        var f = 0;
        var g = 0;
        if (i < 16) {
            f = (b & c) | ((b ^ MASK32) & d);
            g = i;
        } else if (i < 32) {
            f = (d & b) | ((d ^ MASK32) & c);
            g = (5 * i + 1) % 16;
        } else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        } else {
            f = c ^ (b | (d ^ MASK32));
            g = (7 * i) % 16;
        }
        let t = d;
        d = c;
        c = b;
        b = (b + rotl32((a + f + kk[i] + m[g]) & MASK32, ss[i])) & MASK32;
        a = t;
    }
    h[0] = (h[0] + a) & MASK32;
    h[1] = (h[1] + b) & MASK32;
    h[2] = (h[2] + c) & MASK32;
    h[3] = (h[3] + d) & MASK32;
}

# The MD5 digest of the data as 32 lower-case hexadecimal digits.
pub func md5_hex(data: bytes): string {
    var h = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476];
    let kk = step_constants();
    let ss = step_rotations();
    var buf: list[int] = [];
    for (k in 0..64) {
        buf.push(0);
    }
    var m: list[int] = [];
    for (k in 0..16) {
        m.push(0);
    }
    let full = data.len() / 64;
    for (blk in 0..full) {
        load_block(data, blk * 64, 64, edits: buf);
        compress(buf, kk, ss, edits: m, edits: h);
    }
    let tail = padded_tail(data, 64, 8, true);
    var start = 0;
    while (start < tail.len()) {
        for (k in 0..64) {
            buf[k] = tail[start + k];
        }
        compress(buf, kk, ss, edits: m, edits: h);
        start += 64;
    }
    var out: list[string] = [];
    for (word in h) {
        # Little-endian: the low byte first.
        for (k in 0..4) {
            out.push(hex_word((word >> (k * 8)) & 0xFF, 2));
        }
    }
    return out.join("");
}
