@mode(host.dual)

# SHA-512 and SHA-384 (FIPS 180-4) in pure Loup. 64-bit big-endian words
# use the whole of Loup's int, which wraps on overflow like an unsigned
# 64-bit word; right shifts are made logical with shr64, and nothing is
# compared, so the sign never matters.
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code.
#
# Structure: the round constants; compress, which mixes one 128-byte block
# into the state; digest, which runs compress over every full block of the
# data and then over the one or two padded tail blocks from
# hash.common.padded_tail; and the two entry points, which differ only in
# their initial state and in how many words of it they print.

from hash.common import (rotr64, shr64, word64, load_block, padded_tail, hex_word);

# The first 64 bits of the fractional parts of the cube roots of the first
# 80 primes, as 32-bit halves (hex literals above 2^63 do not fit an int).
func round_constants(): list[int] {
    let halves = [
        0x428a2f98, 0xd728ae22, 0x71374491, 0x23ef65cd, 0xb5c0fbcf, 0xec4d3b2f, 0xe9b5dba5, 0x8189dbbc,
        0x3956c25b, 0xf348b538, 0x59f111f1, 0xb605d019, 0x923f82a4, 0xaf194f9b, 0xab1c5ed5, 0xda6d8118,
        0xd807aa98, 0xa3030242, 0x12835b01, 0x45706fbe, 0x243185be, 0x4ee4b28c, 0x550c7dc3, 0xd5ffb4e2,
        0x72be5d74, 0xf27b896f, 0x80deb1fe, 0x3b1696b1, 0x9bdc06a7, 0x25c71235, 0xc19bf174, 0xcf692694,
        0xe49b69c1, 0x9ef14ad2, 0xefbe4786, 0x384f25e3, 0x0fc19dc6, 0x8b8cd5b5, 0x240ca1cc, 0x77ac9c65,
        0x2de92c6f, 0x592b0275, 0x4a7484aa, 0x6ea6e483, 0x5cb0a9dc, 0xbd41fbd4, 0x76f988da, 0x831153b5,
        0x983e5152, 0xee66dfab, 0xa831c66d, 0x2db43210, 0xb00327c8, 0x98fb213f, 0xbf597fc7, 0xbeef0ee4,
        0xc6e00bf3, 0x3da88fc2, 0xd5a79147, 0x930aa725, 0x06ca6351, 0xe003826f, 0x14292967, 0x0a0e6e70,
        0x27b70a85, 0x46d22ffc, 0x2e1b2138, 0x5c26c926, 0x4d2c6dfc, 0x5ac42aed, 0x53380d13, 0x9d95b3df,
        0x650a7354, 0x8baf63de, 0x766a0abb, 0x3c77b2a8, 0x81c2c92e, 0x47edaee6, 0x92722c85, 0x1482353b,
        0xa2bfe8a1, 0x4cf10364, 0xa81a664b, 0xbc423001, 0xc24b8b70, 0xd0f89791, 0xc76c51a3, 0x0654be30,
        0xd192e819, 0xd6ef5218, 0xd6990624, 0x5565a910, 0xf40e3585, 0x5771202a, 0x106aa070, 0x32bbd1b8,
        0x19a4c116, 0xb8d2d0c8, 0x1e376c08, 0x5141ab53, 0x2748774c, 0xdf8eeb99, 0x34b0bcb5, 0xe19b48a8,
        0x391c0cb3, 0xc5c95a63, 0x4ed8aa4a, 0xe3418acb, 0x5b9cca4f, 0x7763e373, 0x682e6ff3, 0xd6b2b8a3,
        0x748f82ee, 0x5defb2fc, 0x78a5636f, 0x43172f60, 0x84c87814, 0xa1f0ab72, 0x8cc70208, 0x1a6439ec,
        0x90befffa, 0x23631e28, 0xa4506ceb, 0xde82bde9, 0xbef9a3f7, 0xb2c67915, 0xc67178f2, 0xe372532b,
        0xca273ece, 0xea26619c, 0xd186b8c7, 0x21c0c207, 0xeada7dd6, 0xcde0eb1e, 0xf57d4f7f, 0xee6ed178,
        0x06f067aa, 0x72176fba, 0x0a637dc5, 0xa2c898a6, 0x113f9804, 0xbef90dae, 0x1b710b35, 0x131c471b,
        0x28db77f5, 0x23047d84, 0x32caab7b, 0x40c72493, 0x3c9ebe0a, 0x15c9bebc, 0x431d67c4, 0x9c100d4c,
        0x4cc5d4be, 0xcb3e42b6, 0x597f299c, 0xfc657e2a, 0x5fcb6fab, 0x3ad6faec, 0x6c44198c, 0x4a475817,
    ];
    var out: list[int] = [];
    var i = 0;
    while (i < halves.len()) {
        out.push(word64(halves[i], halves[i + 1]));
        i += 2;
    }
    return out;
}

# All 64 bits set: x ^ ALL_ONES is the bitwise complement of x.
const ALL_ONES: int = -1;

# Processes one 128-byte block (in buf) into the state h[0..8]; w is an
# 80-word scratch list and k the round constants.
func compress(buf: list[int], k: list[int], edits w: list[int], edits h: list[int]): void {
    # The message schedule: the block's 16 big-endian 64-bit words,
    # expanded to 80. Additions wrap at 64 bits by themselves.
    for (i in 0..16) {
        var word = 0;
        for (j in 0..8) {
            word = (word << 8) | buf[i * 8 + j];
        }
        w[i] = word;
    }
    for (i in 16..80) {
        let s0 = rotr64(w[i - 15], 1) ^ rotr64(w[i - 15], 8) ^ shr64(w[i - 15], 7);
        let s1 = rotr64(w[i - 2], 19) ^ rotr64(w[i - 2], 61) ^ shr64(w[i - 2], 6);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    var a = h[0];
    var b = h[1];
    var c = h[2];
    var d = h[3];
    var e = h[4];
    var f = h[5];
    var g = h[6];
    var hh = h[7];
    # 80 rounds, one per round constant.
    for (i in 0..80) {
        let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
        let ch = (e & f) ^ ((e ^ ALL_ONES) & g);
        let t1 = hh + s1 + ch + k[i] + w[i];
        let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0 + maj;
        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    h[0] = h[0] + a;
    h[1] = h[1] + b;
    h[2] = h[2] + c;
    h[3] = h[3] + d;
    h[4] = h[4] + e;
    h[5] = h[5] + f;
    h[6] = h[6] + g;
    h[7] = h[7] + hh;
}

# Runs SHA-512's compression over the padded data from the initial state
# `h` and returns the first `words` words of the result in hexadecimal.
func digest(data: bytes, h0: list[int], words: int): string {
    var h = h0;
    let k = round_constants();
    var buf: list[int] = [];
    for (n in 0..128) {
        buf.push(0);
    }
    var w: list[int] = [];
    for (n in 0..80) {
        w.push(0);
    }
    let full = data.len() / 128;
    for (blk in 0..full) {
        load_block(data, blk * 128, 128, edits: buf);
        compress(buf, k, edits: w, edits: h);
    }
    let tail = padded_tail(data, 128, 16, false);
    var start = 0;
    while (start < tail.len()) {
        for (n in 0..128) {
            buf[n] = tail[start + n];
        }
        compress(buf, k, edits: w, edits: h);
        start += 128;
    }
    var out: list[string] = [];
    for (n in 0..words) {
        out.push(hex_word(h[n], 16));
    }
    return out.join("");
}

# The SHA-512 digest of the data as 128 lower-case hexadecimal digits.
pub func sha512_hex(data: bytes): string {
    let h = [
        word64(0x6a09e667, 0xf3bcc908), word64(0xbb67ae85, 0x84caa73b),
        word64(0x3c6ef372, 0xfe94f82b), word64(0xa54ff53a, 0x5f1d36f1),
        word64(0x510e527f, 0xade682d1), word64(0x9b05688c, 0x2b3e6c1f),
        word64(0x1f83d9ab, 0xfb41bd6b), word64(0x5be0cd19, 0x137e2179),
    ];
    return digest(data, h, 8);
}

# The SHA-384 digest (SHA-512 with other initial values, cut to 6 words)
# as 96 lower-case hexadecimal digits.
pub func sha384_hex(data: bytes): string {
    let h = [
        word64(0xcbbb9d5d, 0xc1059ed8), word64(0x629a292a, 0x367cd507),
        word64(0x9159015a, 0x3070dd17), word64(0x152fecd8, 0xf70e5939),
        word64(0x67332667, 0xffc00b31), word64(0x8eb44a87, 0x68581511),
        word64(0xdb0c2e0d, 0x64f98fa7), word64(0x47b5481d, 0xbefa4fa4),
    ];
    return digest(data, h, 6);
}
