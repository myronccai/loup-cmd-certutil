@mode(host.dual)

# Command-line parsing for certutil. Like the original it takes options and
# one verb, both written with `-` or `/` in any case, then the verb's
# arguments:
#
#   certutil [-f] [-v] -VERB ARGS...
#
# The verbs are declared as switches of the shared Windows parser
# (win/switches.loup), so `-hashfile`, `/HashFile` and `-HASHFILE` are the
# same. Another `-word` before `--` is an unknown argument; `/x` that is not
# a verb or option is a path.

from win.switches import (SwitchSpec, flag, parse_switches);

# The verbs, in the order the help lists them.
pub const VERBS: list[string] = ["hashfile", "encode", "decode", "encodehex", "decodehex"];

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub command: string;        # the verb in lower case, without its dash; "" for none
    pub operands: list[string];
    pub force: bool;            # -f: overwrite an existing output file
    pub unknown: string;        # the first unknown `-word`, or ""
    pub verbs: int;             # how many verbs were given
}

pub func certutil_switches(): list[SwitchSpec] {
    var specs: list[SwitchSpec] = [flag("F"), flag("V")];
    for (verb in VERBS) {
        specs.push(flag(verb));
    }
    return specs;
}

# The arguments before the first `--`.
func before_double_dash(argv: list[string]): list[string] {
    var out: list[string] = [];
    for (a in argv) {
        if (a == "--") {
            break;
        }
        out.push(a);
    }
    return out;
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let specs = certutil_switches();
    let parsed = match parse_switches(argv, specs) {
        Ok(p) => p,
        Err(e) => {
            return Err("CertUtil: Unknown arg: " + e.text);
        },
    };
    var command = "";
    var verbs = 0;
    var force = false;
    for (sw in parsed.switches) {
        if (sw.name == "F") {
            force = true;
        } else if (sw.name != "V") {
            verbs += 1;
            if (command.len() == 0) {
                command = sw.name.toLowerCase();
            }
        }
    }
    var unknown = "";
    let early = match parse_switches(before_double_dash(argv), specs) {
        Ok(p) => p,
        Err(e) => {
            return Err("CertUtil: Unknown arg: " + e.text);
        },
    };
    for (op in early.operands) {
        if (unknown.len() == 0 and op.len() > 1 and op.startsWith("-")) {
            unknown = op;
        }
    }
    return Ok(Options(
        help = parsed.help,
        version = parsed.version,
        command = command,
        operands = parsed.operands,
        force = force,
        unknown = unknown,
        verbs = verbs,
    ));
}
