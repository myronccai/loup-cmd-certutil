@mode(host.dual)

# Top level of certutil: parse the arguments, handle -? and --version,
# reject unknown arguments and extra verbs, then dispatch to the verb and
# return its ERRORLEVEL.
#
# Runtime: host.dual. Compiled into the native binary build/certutil by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (EXIT_OK);
from cli.args import (Options, parse_args);
from cli.usage import (usage, verb_usage, version_line);
from commands.hashfile import (run_hashfile);
from commands.convert import (run_encode, run_decode, run_encodehex, run_decodehex);
from commands.results import (HR_INVALID_PARAMETER, exit_code, hresult_message);

# Parses argv, runs the verb and returns the exit status (certutil's
# ERRORLEVEL: 0 or an HRESULT).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            return usage_error(msg);
        },
    };

    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    if (opts.help) {
        if (opts.command.len() > 0) {
            println(verb_usage(opts.command));
        } else {
            println(usage());
        }
        return EXIT_OK;
    }
    if (opts.unknown.len() > 0) {
        return usage_error("CertUtil: Unknown arg: " + opts.unknown);
    }
    if (opts.verbs > 1) {
        return usage_error("CertUtil: Too many verbs: one at a time.");
    }

    try {
        return dispatch(opts);
    } catch (Exception as e) {
        printErr("CertUtil: " + e.message);
        return exit_code(HR_INVALID_PARAMETER);
    }
}

# The verbs, as in the template's dispatcher. Add a verb here, to VERBS in
# cli/args.loup and to the help text in cli/usage.loup.
func dispatch(opts: Options): int {
    match opts.command {
        "hashfile" => {
            return run_hashfile(opts);
        },
        "encode" => {
            return run_encode(opts);
        },
        "decode" => {
            return run_decode(opts);
        },
        "encodehex" => {
            return run_encodehex(opts);
        },
        "decodehex" => {
            return run_decodehex(opts);
        },
        _ => {
            # No verb: show what certutil can do here.
            println(usage());
            return EXIT_OK;
        },
    }
}

func usage_error(msg: string): int {
    printErr(msg);
    printErr("CertUtil: " + hresult_message(HR_INVALID_PARAMETER));
    return exit_code(HR_INVALID_PARAMETER);
}
