@mode(host.dual)

# Known-answer tests from RFC 1321 (MD5) and FIPS 180-2 (SHA-1, SHA-2),
# checked against md5sum, sha1sum, sha256sum, sha384sum and sha512sum.

from debug.assert import (expect);
from hash.md5 import (md5_hex);
from hash.sha1 import (sha1_hex);
from hash.sha256 import (sha256_hex);
from hash.sha512 import (sha384_hex, sha512_hex);

func same(got: string, want: string, what: string): void {
    expect(got == want, what + ": got '" + got + "', want '" + want + "'");
}

func test_md5(): void {
    same(md5_hex(b""), "d41d8cd98f00b204e9800998ecf8427e", "empty");
    same(md5_hex(b"abc"), "900150983cd24fb0d6963f7d28e17f72", "abc");
    same(md5_hex(b"message digest"), "f96b697d7cb7938d525a2f31aaf161d0", "message digest");
    same(md5_hex(b"12345678901234567890123456789012345678901234567890123456789012345678901234567890"),
        "57edf4a22be3c955ac49da2e2107b67a", "80 digits: two blocks");
}

func test_sha1(): void {
    same(sha1_hex(b""), "da39a3ee5e6b4b0d3255bfef95601890afd80709", "empty");
    same(sha1_hex(b"abc"), "a9993e364706816aba3e25717850c26c9cd0d89d", "abc");
    same(sha1_hex(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "448 bits");
}

func test_sha256(): void {
    same(sha256_hex(b""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "empty");
    same(sha256_hex(b"abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "abc");
    same(sha256_hex(b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "448 bits");
}

func test_sha384(): void {
    same(sha384_hex(b""),
        "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b",
        "empty");
    same(sha384_hex(b"abc"),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7",
        "abc");
}

func test_sha512(): void {
    same(sha512_hex(b""),
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
        "empty");
    same(sha512_hex(b"abc"),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
        "abc");
    same(sha512_hex(b"abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
        "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
        "896 bits: two blocks");
}
