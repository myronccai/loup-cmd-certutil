@mode(host.dual)

# Unit tests for certutil's argument parsing (cli.args): verbs in any
# spelling, -f and -v, unknown `-words` and `/paths`, -? and --version.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test --no-parallel`, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, certutil_switches, VERBS);

func same(got: string, want: string, what: string): void {
    expect(got == want, what + ": got '" + got + "', want '" + want + "'");
}

func test_verbs(): void {
    expectEq(VERBS.len(), 5, "five verbs");
    expectEq(certutil_switches().len(), 7, "verbs and -f -v");
    let opts = parse_args(["-hashfile", "a.txt", "SHA256"]).unwrap();
    same(opts.command, "hashfile", "verb");
    same(opts.operands.join(","), "a.txt,SHA256", "arguments");
    same(parse_args(["/EncodeHex", "a", "b"]).unwrap().command, "encodehex", "/ and any case");
    same(parse_args(["-ENCODE", "a", "b"]).unwrap().command, "encode", "not encodehex");
}

func test_options(): void {
    let opts = parse_args(["-f", "-v", "-decode", "a", "b"]).unwrap();
    expect(opts.force, "-f");
    same(opts.command, "decode", "verb after options");
    expectEq(opts.verbs, 1, "one verb");
    expectEq(parse_args(["-encode", "-decode"]).unwrap().verbs, 2, "two verbs");
}

func test_unknown_and_paths(): void {
    same(parse_args(["-bogus", "a"]).unwrap().unknown, "-bogus", "unknown -word");
    let opts = parse_args(["-hashfile", "/tmp/a.txt"]).unwrap();
    same(opts.unknown, "", "a /path is not an option");
    same(opts.operands[0], "/tmp/a.txt", "path");
    same(parse_args(["-hashfile", "--", "-x"]).unwrap().unknown, "", "after --");
}

func test_help_and_version(): void {
    expect(parse_args(["-?"]).unwrap().help, "-?");
    let verb_help = parse_args(["-hashfile", "-?"]).unwrap();
    expect(verb_help.help, "verb -?");
    same(verb_help.command, "hashfile", "for that verb");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}
